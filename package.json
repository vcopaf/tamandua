{
  "name": "tamandua",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "9.15.0"
  },
  "scripts": {
    "build": "pnpm --filter @tamandua/core --filter @tamandua/persistence --filter @tamandua/service --filter @tamandua/cli --filter @tamandua/runner --filter @tamandua/extension build",
    "package:release": "pnpm build && node scripts/package-release.mjs",
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:e2e": "pnpm --filter @tamandua/service test && pnpm --filter @tamandua/runner test",
    "typecheck": "pnpm --filter @tamandua/core --filter @tamandua/persistence --filter @tamandua/service --filter @tamandua/cli --filter @tamandua/runner --filter @tamandua/extension typecheck",
    "test": "pnpm --filter @tamandua/core --filter @tamandua/persistence --filter @tamandua/service --filter @tamandua/cli --filter @tamandua/runner --filter @tamandua/extension test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
